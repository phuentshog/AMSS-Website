rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /staffProfiles/{staffUid} {
      // A verified Google account may read only its own active profile.
      // Server/Admin SDK operations bypass these rules and must be tightly controlled.
      allow get: if request.auth != null
        && request.auth.uid == staffUid
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && resource.data.authUid == request.auth.uid
        && resource.data.email is string
        && request.auth.token.email.lower() == resource.data.email.lower()
        && resource.data.isActive == true;

      // No directory enumeration or client-side profile/role changes.
      allow list, create, update, delete: if false;
    }

    // Private by default. Add narrowly scoped rules alongside each real future module.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
